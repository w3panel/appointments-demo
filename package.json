{
  "name": "appointments-demo",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "devturbo": "pnpm dev --turbo",
    "devsafe": "rm -rf .next && pnpm dev",
    "build": "echo \"skip (demo app)\"",
    "build:demo": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "payload",
    "lint": "bunx oxlint app collections components lib --tsconfig ../../tsconfig.oxlint.json --quiet",
    "lint:fix": "bunx oxlint app collections components lib --tsconfig ../../tsconfig.oxlint.json --fix",
    "format": "bunx oxfmt app collections components lib package.json tsconfig.json next.config.mjs payload.config.ts --write",
    "format:check": "bunx oxfmt app collections components lib package.json tsconfig.json next.config.mjs payload.config.ts --check",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@payloadcms/db-postgres": "catalog:",
    "@payloadcms/email-nodemailer": "catalog:",
    "@payloadcms/next": "catalog:",
    "@payloadcms/richtext-lexical": "catalog:",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/postcss": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "moment": "^2.30.1",
    "next": "^16.2.6",
    "nodemailer": "^8.0.7",
    "nuqs": "^2.8.5",
    "payload": "catalog:",
    "payload-appointments-plugin": "workspace:*",
    "react": "catalog:",
    "react-calendar": "^6.0.0",
    "react-dom": "catalog:",
    "react-spinners": "^0.17.0",
    "sharp": "0.34.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.6",
    "@types/node": "25.6.2",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "catalog:",
    "autoprefixer": "^10.4.22",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "oxfmt": "catalog:",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.1.18",
    "@typescript/native-preview": "catalog:"
  }
}
